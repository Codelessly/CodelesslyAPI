{
  "schema": 3,
  "roots": ["story"],
  "nodes": {
    "story": {"type": "canvas", "slots": {"body": "page"}, "layout": {"width": 390, "height": 320},
              "decoration": {"fills": [{"color": "#FFFFFFFF"}]}},
    "page": {"type": "column", "children": ["card"], "layout": {"width": {"fill": 390}, "height": {"fill": 320}, "padding": 24}},
    "card": {
      "type": "column",
      "children": ["kicker", "headline"],
      "layout": {"width": {"fill": 342}, "height": 240, "padding": 20},
      "props": {"mainAxisAlignment": "end", "crossAxisAlignment": "start", "spacing": 6},
      "decoration": {
        "radius": 16,
        "clip": "antiAlias",
        "fills": [
          {"type": "image", "image": {"url": "assets/photo.png", "fit": "cover", "alignment": [0, -0.3]}},
          {"type": "linear", "begin": [0, -1], "end": [0, 1],
           "stops": [{"color": "#00000000", "position": 0.35}, {"color": "#CC000000", "position": 1}]}
        ]
      }
    },
    "kicker": {"type": "text", "layout": {"width": {"fill": 302}, "height": {"hug": 16}},
               "props": {"text": "TRAVEL", "style": {"fontSize": 12, "fontWeight": 700, "letterSpacing": 2, "color": "#FFFDE68A"}}},
    "headline": {"type": "text", "layout": {"width": {"fill": 302}, "height": {"hug": 56}},
                 "props": {"text": "A week on the salt marsh, by boat and on foot",
                           "style": {"fontSize": 20, "fontWeight": 700, "height": 1.3, "color": "#FFFFFFFF"}}}
  }
}
