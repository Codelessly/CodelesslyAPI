{
  "schema": 2,
  "roots": ["home", "about", "signup"],
  "nodes": {
    "home": {"type": "canvas", "name": "Home", "slots": {"body": "homeCol"}, "layout": {"width": 390, "height": 844},
             "decoration": {"fills": [{"color": "#FFFFFFFF"}]}},
    "homeCol": {"type": "column", "children": ["toAbout", "openSignup", "toast"],
                "layout": {"width": {"fill": 390}, "height": {"fill": 844}, "padding": 24},
                "props": {"spacing": 12, "crossAxisAlignment": "start"}},
    "toAbout": {"type": "textButton", "layout": {"width": 160, "height": 40}, "props": {"label": "About us"},
                "actions": [{"trigger": {"type": "click"}, "actions": [{"type": "navigate", "to": "about"}]}]},
    "openSignup": {"type": "textButton", "layout": {"width": 160, "height": 40}, "props": {"label": "Sign up"},
                   "actions": [{"trigger": {"type": "click"},
                                "actions": [{"type": "openModal", "to": "signup", "presentation": "dialog"}]}]},
    "toast": {"type": "textButton", "layout": {"width": 160, "height": 40}, "props": {"label": "Show a toast"},
              "actions": [{"trigger": {"type": "click"},
                           "actions": [{"type": "showToast", "message": "Saved", "style": "success"}]}]},
    "about": {"type": "canvas", "name": "About", "path": "about", "slots": {"body": "aboutCol"},
              "layout": {"width": 390, "height": 844}, "decoration": {"fills": [{"color": "#FFF9FAFB"}]}},
    "aboutCol": {"type": "column", "children": ["aboutTitle", "back"],
                 "layout": {"width": {"fill": 390}, "height": {"fill": 844}, "padding": 24},
                 "props": {"spacing": 12, "crossAxisAlignment": "start"}},
    "aboutTitle": {"type": "text", "layout": {"width": {"fill": 342}, "height": {"hug": 30}},
                   "props": {"text": "About", "style": {"fontSize": 24, "fontWeight": 700, "color": "#FF111827"}}},
    "back": {"type": "textButton", "layout": {"width": 120, "height": 40}, "props": {"label": "Back"},
             "actions": [{"trigger": {"type": "click"}, "actions": [{"type": "navigate", "mode": "pop"}]}]},
    "signup": {"type": "canvas", "name": "Sign up", "slots": {"body": "signupCol"}, "layout": {"width": 320, "height": 200},
               "decoration": {"fills": [{"color": "#FFFFFFFF"}], "radius": 16}},
    "signupCol": {"type": "column", "children": ["signupTitle", "close"],
                  "layout": {"width": {"fill": 320}, "height": {"fill": 200}, "padding": 24},
                  "props": {"spacing": 16}},
    "signupTitle": {"type": "text", "layout": {"width": {"hug": 200}, "height": {"hug": 26}},
                    "props": {"text": "Join the waitlist", "style": {"fontSize": 20, "fontWeight": 700, "color": "#FF111827"}}},
    "close": {"type": "filledButton", "layout": {"width": 120, "height": 40}, "props": {"label": "Close"},
              "actions": [{"trigger": {"type": "click"}, "actions": [{"type": "closeModal"}]}]}
  }
}
