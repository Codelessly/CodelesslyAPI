{
  "schema": 3,
  "roots": ["front"],
  "nodes": {
    "front": {"type": "canvas", "slots": {"body": "page"}, "layout": {"width": 390, "height": 844},
              "decoration": {"fills": [{"color": "#FFFAF7F2"}]}},
    "page": {"type": "column", "children": ["masthead", "main"],
             "layout": {"width": {"fill": 390}, "height": {"fill": 844}},
             "props": {"scrollable": true}},
    "masthead": {"type": "column", "children": ["mastheadInner"],
                 "layout": {"width": {"fill": 390}, "height": {"hug": 72}, "padding": [20, 20, 20, 20]},
                 "decoration": {"fills": [{"color": "#FF1F2A44"}]}},
    "mastheadInner": {"type": "row", "children": ["title", "edition"],
                      "layout": {"width": {"fill": 350}, "height": {"hug": 32}, "constraints": {"maxWidth": 1200}},
                      "props": {"mainAxisAlignment": "spaceBetween"}},
    "title": {"type": "text", "layout": {"width": {"hug": 140}, "height": {"hug": 32}},
              "props": {"text": "The Long Tide", "style": {"fontSize": 24, "fontWeight": 700, "color": "#FFFAF7F2"}}},
    "edition": {"type": "text", "layout": {"width": {"hug": 120}, "height": {"hug": 18}},
                "props": {"text": "Saturday edition", "style": {"fontSize": 13, "color": "#FFCBD5E1"}},
                "media": [{"maxWidth": 599, "patch": {"visible": false}}]},
    "main": {"type": "column", "children": ["split"],
             "layout": {"width": {"fill": 390}, "height": {"hug": 1200}, "padding": [20, 24, 20, 40]}},
    "split": {"type": "flex", "children": ["river", "rail"],
              "layout": {"width": {"fill": 350}, "height": {"hug": 1200}, "constraints": {"maxWidth": 1200}},
              "props": {"direction": "vertical", "spacing": 32, "crossAxisAlignment": "start"},
              "media": [{"minWidth": 834, "patch": {"props": {"direction": "horizontal"}}}]},
    "river": {"type": "gridView", "children": ["story"],
              "layout": {"width": {"fill": 350}, "height": {"hug": 900}},
              "props": {"crossAxisCount": 1, "shrinkWrapRows": true, "physics": "never",
                        "mainAxisSpacing": 28, "crossAxisSpacing": 24},
              "bind": {"data": "${stories}"},
              "media": [{"minWidth": 834, "patch": {"props": {"crossAxisCount": 2}}},
                        {"minWidth": 1200, "patch": {"props": {"crossAxisCount": 3}}}]},
    "story": {"type": "column", "children": ["storyArt", "storyKicker", "storyTitle", "storyDek"],
              "layout": {"width": {"fill": 350}, "height": {"hug": 300}},
              "props": {"spacing": 8, "crossAxisAlignment": "start"},
              "bind": {"layout.columnSpan": "${= index == 0 ? 2 : 1}"}},
    "storyArt": {"type": "box", "layout": {"width": {"fill": 350}, "height": 200},
                 "bind": {"layout.height": "${= index == 0 ? 340 : 200}"},
                 "decoration": {"fills": [{"type": "linear", "begin": "topLeft", "end": "bottomRight",
                                           "stops": [{"position": 0, "color": "#FF94A3B8"}, {"position": 1, "color": "#FF1F2A44"}]}],
                                "radius": 4}},
    "storyKicker": {"type": "text", "layout": {"width": {"fill": 350}, "height": {"hug": 16}},
                    "props": {"text": "${item.section}", "style": {"fontSize": 12, "fontWeight": 700, "letterSpacing": 1.2, "color": "#FFB45309"}}},
    "storyTitle": {"type": "text", "layout": {"width": {"fill": 350}, "height": {"hug": 30}},
                   "props": {"text": "${item.title}", "style": {"fontSize": 20, "fontWeight": 700, "height": 1.2, "color": "#FF111827"}},
                   "bind": {"props.style.fontSize": "${= index == 0 ? 30 : 20}"}},
    "storyDek": {"type": "text", "layout": {"width": {"fill": 350}, "height": {"hug": 40}},
                 "props": {"text": "${item.dek}", "style": {"fontSize": 15, "height": 1.45, "color": "#FF4B5563"}}},
    "rail": {"type": "column", "children": ["railTitle", "railList"],
             "layout": {"width": {"fill": 350}, "height": {"hug": 320}, "padding": 20},
             "decoration": {"fills": [{"color": "#FFFFFFFF"}], "strokes": [{"color": "#FFE5E7EB"}], "radius": 6},
             "props": {"spacing": 14, "crossAxisAlignment": "start"},
             "sticky": {"offset": 24},
             "media": [{"minWidth": 834, "patch": {"layout": {"width": 280}}}]},
    "railTitle": {"type": "text", "layout": {"width": {"fill": 240}, "height": {"hug": 20}},
                  "props": {"text": "Most read", "style": {"fontSize": 16, "fontWeight": 700, "color": "#FF111827"}}},
    "railList": {"type": "listView", "children": ["railItem"],
                 "layout": {"width": {"fill": 240}, "height": {"hug": 200}},
                 "props": {"scrollable": false, "spacing": 12},
                 "bind": {"data": "${mostRead}"}},
    "railItem": {"type": "text", "layout": {"width": {"fill": 240}, "height": {"hug": 40}},
                 "props": {"text": "${= (index + 1) + '. ' + item}", "style": {"fontSize": 14, "height": 1.4, "color": "#FF374151"}}}
  },
  "variables": {"front": [
    {"name": "stories", "type": "list", "value": [
      {"section": "CLIMATE", "title": "Where the marsh moves, the town follows", "dek": "On the Chesapeake's eastern shore, salt water is rewriting the map one field at a time."},
      {"section": "CITIES", "title": "The bus line that rebuilt a neighbourhood", "dek": "Ten years after route 22 opened, its stops are the busiest corners in town."},
      {"section": "SCIENCE", "title": "Counting eels by moonlight", "dek": "Volunteers spend spring nights at the weirs, tallying the year's arrivals."},
      {"section": "FOOD", "title": "Oyster season, earlier every year", "dek": "Warmer water moves the harvest and the festival with it."},
      {"section": "ARTS", "title": "A museum of tide clocks", "dek": "One collector's rooms of brass and glass keep the river's time."}
    ]},
    {"name": "mostRead", "type": "list", "value": [
      "Where the marsh moves, the town follows",
      "Counting eels by moonlight",
      "The ferry's last summer",
      "A museum of tide clocks"
    ]}
  ]}
}
