{
  "title": "Order history",
  "summary": "Lists the shopper's past orders with status, totals and quick reorder or tracking actions.",
  "pattern": "list",
  "appBar": {"title": "Orders", "leading": "back"},
  "data": {
    "summary": {"count": "23 orders", "spent": "$1,948.60", "saved": "$212.40"},
    "orders": [
      {"id": "KSK-88291", "date": "Nov 03, 2026", "items": "Riot Fleece Hoodie", "total": "$96.00", "status": "On the way", "tone": "warning", "image": "https://picsum.photos/seed/riothoodie/200/200"},
      {"id": "KSK-88214", "date": "Oct 28, 2026", "items": "Static Boxy Tee + 2 more", "total": "$164.00", "status": "Delivered", "tone": "success", "image": "https://picsum.photos/seed/boxytee/200/200"},
      {"id": "KSK-87730", "date": "Oct 03, 2026", "items": "Zine Cargo Pant", "total": "$118.00", "status": "Delivered", "tone": "success", "image": "https://picsum.photos/seed/cargopant/200/200"},
      {"id": "KSK-86102", "date": "Sep 12, 2026", "items": "Ink Blot Cap", "total": "$48.00", "status": "Returned", "tone": "neutral", "image": "https://picsum.photos/seed/inkcap/200/200"},
      {"id": "KSK-85544", "date": "Aug 21, 2026", "items": "Checker Skate Low", "total": "$84.00", "status": "Delivered", "tone": "success", "image": "https://picsum.photos/seed/checkerlow/200/200"},
      {"id": "KSK-84017", "date": "Jul 30, 2026", "items": "Concrete Summer LP", "total": "$34.00", "status": "Cancelled", "tone": "error", "image": "https://picsum.photos/seed/concretesummer/200/200"},
      {"id": "KSK-83390", "date": "Jul 02, 2026", "items": "Big Mouth Tote + 1 more", "total": "$90.00", "status": "Delivered", "tone": "success", "image": "https://picsum.photos/seed/bigtote/200/200"}
    ]
  },
  "variables": [
    {"name": "filter", "type": "text", "value": "All"},
    {"name": "query", "type": "text", "value": ""}
  ],
  "sections": [
    {
      "id": "stats",
      "area": "full",
      "layout": "grid",
      "columns": {"mobile": 3, "desktop": 3},
      "children": [
        {"type": "stat", "label": "Orders", "value": "${summary.count}"},
        {"type": "stat", "label": "Spent", "value": "${summary.spent}"},
        {"type": "stat", "label": "Saved", "value": "${summary.saved}", "tone": "success"}
      ]
    },
    {
      "id": "filters",
      "area": "full",
      "layout": "stack",
      "children": [
        {"type": "input", "label": "Find an order", "kind": "search", "bind": "query", "hint": "Order number or item", "icon": "search"},
        {"type": "tabs", "tabs": ["All", "On the way", "Delivered", "Returns"], "bind": "filter"}
      ]
    },
    {
      "id": "active",
      "area": "full",
      "children": [
        {"type": "banner", "tone": "info", "icon": "local_shipping", "title": "KSK-88291 lands Thursday", "message": "Your hoodie is on a truck right now.", "action": {"label": "Track", "action": {"type": "navigate", "to": "Track order", "params": {"id": "KSK-88291"}}}}
      ]
    },
    {
      "id": "orders",
      "area": "full",
      "layout": "stack",
      "children": [
        {
          "type": "list",
          "items": "${orders}",
          "item": {
            "type": "listRow",
            "title": "${item.items}",
            "subtitle": "${item.id} · ${item.date} · ${item.total}",
            "leading": {"image": "${item.image}"},
            "trailing": {"badge": "${item.status}", "tone": "${item.tone}"},
            "action": {"type": "navigate", "to": "Order details", "params": {"id": "${item.id}"}}
          }
        },
        {"type": "button", "label": "Load older orders", "variant": "outline", "icon": "expand_more", "action": {"type": "toast", "message": "Digging up older orders"}}
      ]
    }
  ],
  "states": {
    "loading": {"style": "skeleton"},
    "empty": {"icon": "receipt_long", "title": "No orders yet", "message": "Your first haul shows up here. Go find something loud.", "action": {"label": "Start shopping", "action": {"type": "navigate", "to": "Home"}}},
    "error": {"icon": "error_outline", "title": "Orders didn't load", "message": "Our filing cabinet jammed. Try again.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
