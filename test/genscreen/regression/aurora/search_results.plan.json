{
  "title": "Search results",
  "summary": "Shows running shoes matching the search, with filters, sorting and a product grid.",
  "pattern": "search",
  "appBar": {"title": "Search", "leading": "back"},
  "nav": {
    "items": [
      {"icon": "home", "label": "Home", "action": {"type": "navigate", "to": "Home"}},
      {"icon": "search", "label": "Search", "active": true, "action": {"type": "navigate", "to": "Search"}},
      {"icon": "shopping_bag", "label": "Bag", "action": {"type": "navigate", "to": "Cart"}},
      {"icon": "person_outline", "label": "Account", "action": {"type": "navigate", "to": "Profile"}}
    ]
  },
  "data": {
    "resultCount": "128 results",
    "shoes": [
      {"name": "Cloudstride 4", "brand": "Veloce", "price": "$139.00", "rating": "4.7 · 1,284 reviews", "image": "https://picsum.photos/seed/runshoe1/600/600"},
      {"name": "Tempo Racer", "brand": "Northpeak", "price": "$165.00", "rating": "4.6 · 842 reviews", "image": "https://picsum.photos/seed/runshoe2/600/600"},
      {"name": "Daily Glide 2", "brand": "Arca", "price": "$110.00", "rating": "4.5 · 2,031 reviews", "image": "https://picsum.photos/seed/runshoe3/600/600"},
      {"name": "Trail Grip GTX", "brand": "Summit", "price": "$175.00", "rating": "4.8 · 519 reviews", "image": "https://picsum.photos/seed/runshoe4/600/600"},
      {"name": "Pacer Lite", "brand": "Veloce", "price": "$95.00", "rating": "4.3 · 1,102 reviews", "image": "https://picsum.photos/seed/runshoe5/600/600"},
      {"name": "Marathon Pro Carbon", "brand": "Northpeak", "price": "$249.00", "rating": "4.9 · 376 reviews", "image": "https://picsum.photos/seed/runshoe6/600/600"},
      {"name": "Recovery Foam", "brand": "Arca", "price": "$120.00", "rating": "4.4 · 690 reviews", "image": "https://picsum.photos/seed/runshoe7/600/600"},
      {"name": "Street Runner", "brand": "Summit", "price": "$89.00", "rating": "4.2 · 954 reviews", "image": "https://picsum.photos/seed/runshoe8/600/600"}
    ]
  },
  "variables": [
    {"name": "query", "type": "text", "value": "running shoes"},
    {"name": "filter", "type": "text", "value": "All"},
    {"name": "sortBy", "type": "text", "value": "Relevance"}
  ],
  "sections": [
    {
      "id": "search",
      "area": "full",
      "layout": "stack",
      "children": [
        {"type": "input", "label": "Search products", "bind": "query", "kind": "search", "icon": "search", "hint": "Shoes, apparel, gear"},
        {
          "type": "chips",
          "bind": "filter",
          "items": [
            {"label": "All", "selected": true, "action": {"type": "set", "variable": "filter", "value": "All"}},
            {"label": "Road", "action": {"type": "set", "variable": "filter", "value": "Road"}},
            {"label": "Trail", "action": {"type": "set", "variable": "filter", "value": "Trail"}},
            {"label": "Racing", "action": {"type": "set", "variable": "filter", "value": "Racing"}},
            {"label": "Under $120", "action": {"type": "set", "variable": "filter", "value": "Under $120"}}
          ]
        },
        {
          "type": "group",
          "direction": "row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            {"type": "text", "text": "${resultCount} for \"running shoes\"", "style": "label", "color": "onSurfaceVariant"},
            {"type": "button", "label": "Sort: relevance", "icon": "sort", "variant": "outline", "size": "small", "action": {"type": "toast", "message": "Sort options"}}
          ]
        }
      ]
    },
    {
      "id": "results",
      "area": "full",
      "layout": "stack",
      "children": [
        {
          "type": "grid",
          "items": "${shoes}",
          "columns": {"mobile": 2, "tablet": 3, "desktop": 4},
          "item": {
            "type": "card",
            "image": "${item.image}",
            "aspect": "1:1",
            "eyebrow": "${item.brand}",
            "title": "${item.name}",
            "meta": "${item.rating}",
            "price": "${item.price}",
            "action": {"type": "navigate", "to": "Product details", "params": {"name": "${item.name}"}}
          }
        },
        {"type": "button", "label": "Load more results", "variant": "outline", "action": {"type": "toast", "message": "Loading 24 more"}}
      ]
    }
  ],
  "states": {
    "loading": {"style": "skeleton"},
    "empty": {"icon": "search", "title": "No shoes match", "message": "Try fewer filters or a broader term like \"sneakers\".", "action": {"label": "Clear filters", "action": {"type": "set", "variable": "filter", "value": "All"}}},
    "error": {"icon": "error_outline", "title": "Couldn't load results", "message": "Check your connection and try again.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
