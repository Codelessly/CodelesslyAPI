{
  "title": "Sign in",
  "summary": "Signs people in with email and password, with options to reset the password or create an account.",
  "pattern": "auth",
  "variables": [
    {"name": "email", "type": "text", "value": ""},
    {"name": "password", "type": "text", "value": ""},
    {"name": "rememberMe", "type": "boolean", "value": true}
  ],
  "sections": [
    {
      "id": "header",
      "layout": "stack",
      "children": [
        {"type": "icon", "icon": "account_balance_wallet", "color": "primary", "size": "xl"},
        {"type": "heading", "title": "Welcome back", "subtitle": "Sign in to see your accounts and payments.", "align": "center"}
      ]
    },
    {
      "id": "form",
      "layout": "stack",
      "children": [
        {"type": "input", "label": "Email", "bind": "email", "kind": "email", "hint": "you@company.com", "icon": "email"},
        {"type": "input", "label": "Password", "bind": "password", "kind": "password", "hint": "At least 8 characters", "icon": "lock_outline"},
        {
          "type": "group",
          "direction": "row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            {"type": "checkbox", "label": "Remember me", "bind": "rememberMe"},
            {"type": "button", "label": "Forgot password?", "variant": "ghost", "size": "small", "action": {"type": "navigate", "to": "Reset password"}}
          ]
        },
        {"type": "button", "label": "Sign in", "variant": "primary", "fullWidth": true, "action": {"type": "submit", "message": "Signed in", "then": {"type": "navigate", "to": "Home"}}},
        {"type": "divider"},
        {"type": "button", "label": "Sign in with passkey", "icon": "key", "variant": "outline", "fullWidth": true, "action": {"type": "submit", "message": "Passkey verified", "then": {"type": "navigate", "to": "Home"}}}
      ]
    },
    {
      "id": "footer",
      "layout": "stack",
      "children": [
        {"type": "text", "text": "New here?", "style": "body", "color": "onSurfaceVariant", "align": "center"},
        {"type": "button", "label": "Create an account", "variant": "ghost", "action": {"type": "navigate", "to": "Create account"}}
      ]
    }
  ],
  "states": {
    "loading": {"style": "spinner"},
    "error": {"icon": "error_outline", "title": "Couldn't sign you in", "message": "We couldn't reach the server. Your details are safe. Try again in a moment.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
