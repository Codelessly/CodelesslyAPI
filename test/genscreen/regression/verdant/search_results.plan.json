{
  "title": "Running shoes",
  "summary": "Shows search results for sustainably made running shoes with filters and sorting.",
  "pattern": "search",
  "appBar": {"title": "Search", "leading": "back"},
  "nav": {
    "items": [
      {"icon": "home", "label": "Home", "action": {"type": "navigate", "to": "Home"}},
      {"icon": "search", "label": "Search", "active": true, "action": {"type": "navigate", "to": "Search"}},
      {"icon": "favorite_border", "label": "Saved", "action": {"type": "navigate", "to": "Saved"}},
      {"icon": "person_outline", "label": "Profile", "action": {"type": "navigate", "to": "Profile"}}
    ]
  },
  "data": {
    "resultCount": "24 shoes",
    "results": [
      {"name": "Fernstep Trail", "brand": "Alder & Co.", "price": "$138", "meta": "Recycled mesh · Trail", "rating": "4.8", "image": "https://picsum.photos/seed/fernsteptrail/800/1000"},
      {"name": "Meadow Road Runner", "brand": "Kindly Footwear", "price": "$120", "meta": "Natural rubber · Road", "rating": "4.6", "image": "https://picsum.photos/seed/meadowrunner/800/1000"},
      {"name": "Cedar Glide", "brand": "Northwood", "price": "$145", "meta": "Wool upper · Road", "rating": "4.7", "image": "https://picsum.photos/seed/cedarglide/800/1000"},
      {"name": "Moss Light", "brand": "Alder & Co.", "price": "$112", "meta": "Plant-based foam · Everyday", "rating": "4.5", "image": "https://picsum.photos/seed/mosslight/800/1000"},
      {"name": "Ridge Path Pro", "brand": "Kindly Footwear", "price": "$155", "meta": "Recycled mesh · Trail", "rating": "4.9", "image": "https://picsum.photos/seed/ridgepath/800/1000"},
      {"name": "Sunrise Tempo", "brand": "Northwood", "price": "$128", "meta": "Cork insole · Road", "rating": "4.4", "image": "https://picsum.photos/seed/sunrisetempo/800/1000"}
    ]
  },
  "variables": [
    {"name": "query", "type": "text", "value": "running shoes"},
    {"name": "terrain", "type": "text", "value": "All"}
  ],
  "sections": [
    {
      "id": "search",
      "area": "full",
      "children": [
        {"type": "input", "label": "Search", "bind": "query", "kind": "search", "hint": "Search shoes, gear and more", "icon": "search"},
        {
          "type": "chips",
          "bind": "terrain",
          "items": [
            {"label": "All", "selected": true, "action": {"type": "set", "variable": "terrain", "value": "All"}},
            {"label": "Road", "action": {"type": "set", "variable": "terrain", "value": "Road"}},
            {"label": "Trail", "action": {"type": "set", "variable": "terrain", "value": "Trail"}},
            {"label": "Everyday", "action": {"type": "set", "variable": "terrain", "value": "Everyday"}},
            {"label": "Under $130", "action": {"type": "set", "variable": "terrain", "value": "Under $130"}}
          ]
        }
      ]
    },
    {
      "id": "results",
      "area": "full",
      "children": [
        {
          "type": "group",
          "direction": "row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            {"type": "text", "text": "We found ${resultCount} for you", "style": "subtitle", "color": "onSurface"},
            {"type": "button", "label": "Sort", "icon": "sort", "variant": "ghost", "size": "small", "action": {"type": "toast", "message": "Sorted by most loved."}}
          ]
        },
        {
          "type": "grid",
          "items": "${results}",
          "columns": {"mobile": 2, "tablet": 3, "desktop": 3},
          "item": {"type": "card", "image": "${item.image}", "aspect": "4:5", "eyebrow": "${item.brand}", "title": "${item.name}", "meta": "${item.meta} · ★ ${item.rating}", "price": "${item.price}", "action": {"type": "navigate", "to": "Product details", "params": {"name": "${item.name}"}}}
        }
      ]
    }
  ],
  "states": {
    "loading": {"style": "skeleton"},
    "empty": {"icon": "search", "title": "No shoes match just yet", "message": "Try a broader search or clear a filter, and we'll look again.", "action": {"label": "Clear filters", "action": {"type": "set", "variable": "terrain", "value": "All"}}},
    "error": {"icon": "error_outline", "title": "We couldn't finish your search", "message": "The connection slipped away for a moment. Let's try again.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
