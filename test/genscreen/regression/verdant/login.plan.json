{
  "title": "Welcome back",
  "summary": "Lets returning members sign in with their email and password.",
  "pattern": "auth",
  "data": {
    "brand": {"name": "Verdant", "image": "https://picsum.photos/seed/sagegarden/1200/800"}
  },
  "variables": [
    {"name": "email", "type": "text", "value": ""},
    {"name": "password", "type": "text", "value": ""},
    {"name": "rememberMe", "type": "boolean", "value": true}
  ],
  "sections": [
    {
      "id": "intro",
      "layout": "stack",
      "children": [
        {"type": "icon", "icon": "eco", "color": "primary", "size": "xl"},
        {"type": "heading", "title": "Welcome back", "subtitle": "We're glad you're here. Sign in to pick up where you left off.", "size": "large"}
      ]
    },
    {
      "id": "form",
      "layout": "stack",
      "children": [
        {"type": "input", "label": "Email", "bind": "email", "kind": "email", "hint": "you@example.com", "icon": "mail"},
        {"type": "input", "label": "Password", "bind": "password", "kind": "password", "hint": "Your password", "icon": "lock_outline"},
        {"type": "checkbox", "label": "Keep me signed in", "bind": "rememberMe"},
        {"type": "button", "label": "Sign in", "variant": "primary", "fullWidth": true, "action": {"type": "submit", "message": "Welcome back. Let's take it slow today.", "then": {"type": "navigate", "to": "Home"}}},
        {"type": "button", "label": "Forgot your password?", "variant": "ghost", "fullWidth": true, "action": {"type": "navigate", "to": "Reset password"}}
      ]
    },
    {
      "id": "signup",
      "layout": "stack",
      "children": [
        {"type": "divider"},
        {"type": "text", "text": "New to Verdant? We'd love to have you.", "style": "body", "color": "onSurfaceVariant", "align": "center"},
        {"type": "button", "label": "Create an account", "variant": "outline", "fullWidth": true, "action": {"type": "navigate", "to": "Create account"}}
      ]
    }
  ],
  "states": {
    "loading": {"style": "spinner"},
    "error": {"icon": "error_outline", "title": "We couldn't sign you in", "message": "Please check your email and password, then try again.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
