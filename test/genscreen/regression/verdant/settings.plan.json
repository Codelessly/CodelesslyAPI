{
  "title": "Settings",
  "summary": "Lets members adjust their account, gentle reminders, appearance and privacy preferences.",
  "pattern": "settings",
  "appBar": {"title": "Settings", "leading": "back"},
  "data": {
    "user": {"name": "Maya Ellison", "email": "maya.ellison@fernmail.com", "avatar": "https://picsum.photos/seed/mayaellison/200/200", "plan": "Verdant Plus"}
  },
  "variables": [
    {"name": "dailyReminder", "type": "boolean", "value": true},
    {"name": "recipeIdeas", "type": "boolean", "value": true},
    {"name": "weeklyReflection", "type": "boolean", "value": false},
    {"name": "theme", "type": "text", "value": "System"},
    {"name": "units", "type": "text", "value": "Metric"},
    {"name": "shareProgress", "type": "boolean", "value": false}
  ],
  "sections": [
    {
      "id": "account",
      "title": "Account",
      "children": [
        {"type": "listRow", "title": "${user.name}", "subtitle": "${user.email}", "leading": {"avatar": "${user.avatar}"}, "trailing": "chevron", "action": {"type": "navigate", "to": "Edit profile"}},
        {"type": "listRow", "title": "Membership", "subtitle": "${user.plan} · renews 14 March 2027", "leading": {"icon": "spa"}, "trailing": "chevron", "action": {"type": "navigate", "to": "Membership"}},
        {"type": "listRow", "title": "Password and sign-in", "subtitle": "Last changed in August", "leading": {"icon": "lock_outline"}, "trailing": "chevron", "action": {"type": "navigate", "to": "Security"}}
      ]
    },
    {
      "id": "reminders",
      "title": "Gentle reminders",
      "children": [
        {"type": "switchRow", "title": "Daily check-in", "subtitle": "A soft nudge at 8:00 each morning", "icon": "wb_sunny", "bind": "dailyReminder"},
        {"type": "switchRow", "title": "Seasonal recipe ideas", "subtitle": "Two new recipes each week", "icon": "restaurant", "bind": "recipeIdeas"},
        {"type": "switchRow", "title": "Weekly reflection", "subtitle": "Sunday evening, a look back at your week", "icon": "self_improvement", "bind": "weeklyReflection"}
      ]
    },
    {
      "id": "appearance",
      "title": "Appearance and units",
      "children": [
        {"type": "text", "text": "Theme", "style": "label", "color": "onSurface"},
        {"type": "segmented", "options": ["Light", "Dark", "System"], "bind": "theme"},
        {"type": "text", "text": "Measurements", "style": "label", "color": "onSurface"},
        {"type": "segmented", "options": ["Metric", "Imperial"], "bind": "units"}
      ]
    },
    {
      "id": "privacy",
      "title": "Privacy",
      "children": [
        {"type": "switchRow", "title": "Share progress with friends", "subtitle": "Friends see your streaks, never your notes", "icon": "group", "bind": "shareProgress"},
        {"type": "listRow", "title": "Download my data", "subtitle": "We'll email you a copy within a day", "leading": {"icon": "download"}, "trailing": "chevron", "action": {"type": "submit", "message": "We're preparing your data and will email it soon."}},
        {"type": "listRow", "title": "Help and support", "subtitle": "We're here if you need us", "leading": {"icon": "support_agent"}, "trailing": "chevron", "action": {"type": "navigate", "to": "Support"}}
      ]
    },
    {
      "id": "signout",
      "children": [
        {"type": "button", "label": "Sign out", "icon": "logout", "variant": "outline", "fullWidth": true, "action": {"type": "navigate", "to": "Login"}}
      ]
    }
  ],
  "states": {
    "loading": {"style": "skeleton"},
    "error": {"icon": "error_outline", "title": "We couldn't load your settings", "message": "Your preferences are safe. Let's try loading them again.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
