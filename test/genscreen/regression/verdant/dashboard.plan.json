{
  "title": "Insights",
  "summary": "Gives the Verdant team a calm overview of members, recipe engagement and practice activity this month.",
  "pattern": "dashboard",
  "appBar": {
    "title": "Insights",
    "actions": [
      {"icon": "download", "label": "Export report", "action": {"type": "toast", "message": "We're preparing your report."}}
    ]
  },
  "nav": {
    "items": [
      {"icon": "dashboard", "label": "Overview", "active": true, "action": {"type": "navigate", "to": "Dashboard"}},
      {"icon": "restaurant", "label": "Recipes", "action": {"type": "navigate", "to": "Recipe analytics"}},
      {"icon": "group", "label": "Members", "action": {"type": "navigate", "to": "Members"}},
      {"icon": "settings", "label": "Settings", "action": {"type": "navigate", "to": "Settings"}}
    ]
  },
  "data": {
    "kpis": {
      "members": {"value": "18,420", "delta": "+6.2%"},
      "recipes": {"value": "42,915", "delta": "+11.4%"},
      "minutes": {"value": "312k", "delta": "+8.1%"},
      "churn": {"value": "2.3%", "delta": "-0.4%"}
    },
    "goal": {"value": 0.78, "caption": "15,600 of 20,000 active members. A lovely climb this month."},
    "topRecipes": [
      {"rank": "1", "title": "Miso roasted squash", "subtitle": "4,812 cooks · 4.9 rating", "trend": "+18%"},
      {"rank": "2", "title": "Lemon and thyme lentils", "subtitle": "3,976 cooks · 4.8 rating", "trend": "+12%"},
      {"rank": "3", "title": "Green herb soup", "subtitle": "3,402 cooks · 4.7 rating", "trend": "+9%"},
      {"rank": "4", "title": "Oat and pear porridge", "subtitle": "2,880 cooks · 4.8 rating", "trend": "+6%"},
      {"rank": "5", "title": "Roasted beet salad", "subtitle": "2,415 cooks · 4.6 rating", "trend": "+4%"}
    ],
    "practices": [
      {"title": "Morning stretch", "subtitle": "98k minutes · 22% of practice", "icon": "self_improvement"},
      {"title": "Box breathing", "subtitle": "74k minutes · 17% of practice", "icon": "spa"},
      {"title": "Evening wind-down", "subtitle": "61k minutes · 14% of practice", "icon": "nightlight"}
    ]
  },
  "variables": [
    {"name": "range", "type": "text", "value": "30 days"}
  ],
  "sections": [
    {
      "id": "header",
      "area": "full",
      "children": [
        {"type": "heading", "title": "Good morning, Priya", "subtitle": "Here's how our community has been growing."},
        {"type": "segmented", "options": ["7 days", "30 days", "90 days"], "bind": "range"}
      ]
    },
    {
      "id": "kpis",
      "area": "full",
      "layout": "grid",
      "columns": {"mobile": 2, "desktop": 4},
      "children": [
        {"type": "stat", "label": "Active members", "value": "${kpis.members.value}", "delta": "${kpis.members.delta}", "tone": "success"},
        {"type": "stat", "label": "Recipes cooked", "value": "${kpis.recipes.value}", "delta": "${kpis.recipes.delta}", "tone": "success"},
        {"type": "stat", "label": "Mindful minutes", "value": "${kpis.minutes.value}", "delta": "${kpis.minutes.delta}", "tone": "success"},
        {"type": "stat", "label": "Monthly churn", "value": "${kpis.churn.value}", "delta": "${kpis.churn.delta}", "tone": "success"}
      ]
    },
    {
      "id": "topRecipes",
      "title": "Most cooked recipes",
      "area": "main",
      "children": [
        {
          "type": "list",
          "items": "${topRecipes}",
          "gap": "xs",
          "item": {"type": "listRow", "title": "${item.title}", "subtitle": "${item.subtitle}", "leading": {"text": "${item.rank}"}, "trailing": {"badge": "${item.trend}", "tone": "success"}, "action": {"type": "navigate", "to": "Recipe analytics", "params": {"title": "${item.title}"}}}
        }
      ]
    },
    {
      "id": "goal",
      "title": "Quarterly goal",
      "area": "aside",
      "children": [
        {"type": "progress", "value": "${goal.value}", "label": "Active members", "caption": "${goal.caption}", "color": "primary"}
      ]
    },
    {
      "id": "practices",
      "title": "Favorite practices",
      "area": "aside",
      "children": [
        {
          "type": "list",
          "items": "${practices}",
          "gap": "xs",
          "item": {"type": "listRow", "title": "${item.title}", "subtitle": "${item.subtitle}", "leading": {"icon": "${item.icon}"}}
        }
      ]
    }
  ],
  "states": {
    "loading": {"style": "skeleton"},
    "empty": {"icon": "insights", "title": "No activity to show yet", "message": "Once members start cooking and practicing, we'll gather their progress here. Try a wider date range.", "action": {"label": "Show 90 days", "action": {"type": "set", "variable": "range", "value": "90 days"}}},
    "error": {"icon": "error_outline", "title": "We couldn't load your insights", "message": "The numbers are safe. Let's fetch them again.", "action": {"label": "Try again", "action": {"type": "retry"}}}
  }
}
